<div class="card"><h2>Clients</h2><div class="stats">
 <div class="stat"><b>{{ kc.total }}</b><span>clients</span></div>
 <div class="stat"><b>{{ kc.nouveaux }}</b><span>nouveaux (30 jours)</span></div>
