_CSS_ESPACE = re.search(r"<style>.*?</style>", ESPACE_HAUT, re.S).group(0)
LIV_CSS = _CSS_ESPACE + """<style>
.liv-kp{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;margin-bottom:18px}
.liv-cmd{background:var(--card);border:1px solid var(--bord);border-radius:18px;padding:14px;margin-bottom:12px;box-shadow:var(--ombre)}
.liv-cmd.urgent{border-color:var(--ambre)}.liv-cmd .t{display:flex;justify-content:space-between;gap:10px;align-items:flex-start;flex-wrap:wrap}
.liv-cmd .grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:10px 0}.liv-cmd .box{border:1px solid var(--bord);border-radius:12px;padding:9px 11px;background:var(--bg);min-width:0}
.liv-cmd .box small{display:block;color:var(--mut);font-size:.68rem;text-transform:uppercase;letter-spacing:.05em;font-weight:750;margin-bottom:3px}.liv-cmd .box b,.liv-cmd .box span{display:block;overflow-wrap:anywhere}
.liv-cmd .box a{color:var(--vert);font-weight:700;text-decoration:none}.liv-cmd form{margin:0}.liv-cmd .acts{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}.liv-cmd .acts form{flex:1}.liv-cmd .acts button{width:100%}
.liv-cmd details summary{cursor:pointer;color:var(--mut);font-weight:650;margin-top:8px}.liv-cmd details form{display:flex;gap:7px;margin-top:8px}.liv-cmd details input{flex:1;padding:9px;border:1px solid var(--bord);border-radius:10px;font:inherit;background:var(--card);color:var(--txt)}
.liv-puce{display:inline-block;padding:3px 10px;border-radius:999px;font-size:.74rem;font-weight:750;background:var(--soft);color:var(--vert)}.liv-puce.ambre{background:rgba(240,165,0,.16);color:#a87400}.liv-puce.gris{background:var(--bg);color:var(--mut)}
.liv-flash{background:var(--soft);border:1px solid var(--vert2);border-radius:14px;padding:10px 14px;margin-bottom:14px;font-weight:650}
.liv-row{display:flex;justify-content:space-between;gap:10px;align-items:center;padding:11px 0;border-bottom:1px solid var(--bord)}.liv-row:last-child{border:0}
</style>"""

LIV_HAUT = """<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#0b7a3b"><link rel="manifest" href="{{ url_for('static', filename='manifest-livreur.webmanifest') }}"><link rel="apple-touch-icon" href="{{ url_for('static', filename='icons/icon-192.png') }}"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"><script src="{{ url_for('static', filename='pwa.js') }}" defer></script><title>{{ titre }} · Espace livreur</title>""" + LIV_CSS + """
<meta name="robots" content="noindex,nofollow"><meta name="referrer" content="no-referrer"><style>.onglets{overflow-x:auto}</style></head><body>
<header class="hero petit"><div class="wrap"><div class="marque"><span class="t">🏍️ Espace livreur</span><span class="mut" style="color:#d5eadc">{{ nom }}</span></div>
<div class="ident"><span class="logo-p">{{ initiale(livreur.nom) }}</span><div><h1 class="titre" style="font-size:clamp(1.4rem,5vw,1.9rem);margin:0">Bonjour {{ livreur.nom }} 👋</h1><p>{% if livreur.base %}📍 {{ livreur.base }}{% else %}Bonne route !{% endif %}</p></div></div>
<div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:12px"><button class="btn sec" id="installer-app" type="button">📲 Installer l’application</button><form method="post" action="{{ url_for('deconnexion') }}"><input type="hidden" name="_csrf" value="{{ csrf_portail() }}"><button class="btn sec">Déconnexion</button></form></div></div></header>
<main class="wrap">{% if msg %}<div class="liv-flash">{{ msg }}</div>{% endif %}
"""

LIV_BAS = """</main>
<nav class="onglets"><a class="{{ 'on' if onglet == 'courses' }}" href="{{ url_for('portail_livreur') }}"><i>📍</i>Courses</a>
<a class="{{ 'on' if onglet == 'historique' }}" href="{{ url_for('portail_livreur_historique') }}"><i>✅</i>Historique</a>
<a class="{{ 'on' if onglet == 'gains' }}" href="{{ url_for('portail_livreur_gains') }}"><i>💰</i>Gains</a>
<a class="{{ 'on' if onglet == 'compte' }}" href="{{ url_for('portail_livreur_compte') }}"><i>⚙️</i>Compte</a></nav>
</body></html>"""

LIV_COURSES = LIV_HAUT.replace("{{ titre }}", "Courses") + """
<style>.liv-cmd{padding:0;overflow:hidden}.liv-cmd>summary{display:flex;justify-content:space-between;gap:10px;align-items:flex-start;flex-wrap:wrap;cursor:pointer;list-style:none;padding:14px}.liv-cmd>summary::-webkit-details-marker{display:none}.liv-cmd>summary:after{content:'＋';color:var(--vert);font-weight:800}.liv-cmd[open]>summary:after{content:'−'}.liv-cmd[open]>summary{border-bottom:1px solid var(--bord)}.liv-cmd-body{padding:0 14px 14px}.liv-cmd>summary .t{flex:1}</style>
<div class="liv-kp"><div class="stat"><b>{{ en_cours_n }}</b><span>courses à suivre</span></div><div class="stat"><b>{{ jour }}</b><span>livrées aujourd’hui</span></div><div class="stat"><b>{{ semaine }}</b><span>livrées cette semaine</span></div></div>
""" + GPS_LIVREUR + """
<h2 class="s">📍 Mes courses</h2>
{% for c in courses %}{% set l = c.l %}<details class="liv-cmd {{ 'urgent' if l.statut == 'collecté' }}"><summary><div class="t"><div><b>{{ l.numero or ('LIV-' ~ '%04d'|format(l.id)) }}</b> · <span class="mut">{{ (l.cree_le or '')[11:16] }}</span></div>
<span class="liv-puce {{ 'ambre' if l.statut == 'collecté' }}">{% if l.statut == 'en attente' %}📦 À récupérer{% elif l.statut == 'collecté' %}🏍️ En route{% else %}✅ Livrée · paiement à confirmer{% endif %}</span></div>
</summary><div class="liv-cmd-body">
<div class="grid"><div class="box"><small>📦 Colis</small><b>{{ l.colis or 'Livraison' }}</b>{% if c.articles %}{% for a in c.articles %}<span>{{ a.quantite|qte }} × {{ a.nom }}</span>{% endfor %}{% endif %}</div>
<div class="box"><small>📍 À récupérer</small><b>{{ l.collecte_lieu or 'Lieu à préciser' }}</b><span>{{ l.collecte_quartier or '' }}</span></div>
<div class="box"><small>🏁 À livrer</small><b>{{ l.destinataire_nom or l.client_nom or 'Destinataire' }}</b><span>{{ l.livraison_adresse or '' }}{% if l.livraison_quartier %} · {{ l.livraison_quartier }}{% endif %}</span>{% if l.destinataire_tel or l.client_tel %}{% set tel = l.destinataire_tel or l.client_tel %}<a href="tel:{{ tel }}">📞 {{ tel }}</a>{% endif %}</div>
<div class="box"><small>💰 Paiement</small>{% if l.prix_course %}<b>{{ l.prix_course|fcfa }} F</b><span>{{ l.mode_paiement or 'mode à confirmer' }} · encaisse : {{ l.encaisse_course_prevu or 'À préciser' }}</span>{% else %}<span>Pas de montant indiqué</span>{% endif %}{% if l.statut_paiement == 'payé' %}<span>✅ déjà réglé</span>{% endif %}</div></div>
{% if l.remarques %}<p class="mut" style="margin:0 0 6px">📝 {{ l.remarques }}</p>{% endif %}
<div class="acts">{% if l.statut == 'en attente' %}<form method="post" action="{{ url_for('portail_livreur_action', id=l.id, quoi='collecte') }}"><input type="hidden" name="_csrf" value="{{ csrf_portail() }}"><button class="btn">✅ Colis récupéré</button></form>{% elif l.statut == 'collecté' %}<form method="post" action="{{ url_for('portail_livreur_action', id=l.id, quoi='livre') }}"><input type="hidden" name="_csrf" value="{{ csrf_portail() }}"><button class="btn">🏁 Livraison effectuée</button></form>{% elif l.statut == 'livré' and l.statut_paiement != 'payé' %}<form method="post" action="{{ url_for('portail_livreur_action', id=l.id, quoi='paye') }}" onsubmit="return confirm('Confirmer que le paiement a bien été reçu ?')"><input type="hidden" name="_csrf" value="{{ csrf_portail() }}"><button class="btn">💰 Paiement reçu</button></form>{% endif %}</div>
{% if l.statut in ('en attente','collecté') %}<details><summary>⚠️ Signaler un problème</summary><form method="post" action="{{ url_for('portail_livreur_action', id=l.id, quoi='probleme') }}"><input type="hidden" name="_csrf" value="{{ csrf_portail() }}"><input name="note" maxlength="250" required placeholder="Client absent, adresse introuvable…"><button class="btn sec">Envoyer</button></form></details>{% endif %}
</div></details>{% else %}<p class="vide">Aucune course en cours. Les nouvelles missions apparaîtront ici.</p>{% endfor %}
<p style="text-align:center"><button type="button" class="btn sec" onclick="location.reload()">🔄 Actualiser</button></p>
""" + LIV_BAS

LIV_BAS_SANS_FIN = LIV_BAS.replace("</body></html>", "")
LIV_HISTO = LIV_HAUT.replace("{{ titre }}", "Historique") + """
<h2 class="s">✅ Mes livraisons</h2>
<div class="carte" style="padding:6px 14px">{% for l in livraisons %}<div class="liv-row"><div><b>{{ l.numero }}</b><div class="mut">{{ (l.heure_livraison or l.cree_le or '')[:16] }} · {{ l.livraison_quartier or '' }}</div></div>
<div style="text-align:right"><b>{{ (l.prix_course or 0)|fcfa }} F</b><div>{% if l.statut == 'livré' and l.statut_paiement == 'payé' %}<span class="liv-puce">payée</span>{% elif l.statut == 'livré' %}<span class="liv-puce ambre">à confirmer</span>{% else %}<span class="liv-puce gris">{{ l.statut }}</span>{% endif %}</div></div></div>
{% else %}<p class="vide">Tes livraisons terminées apparaîtront ici.</p>{% endfor %}</div>
""" + LIV_BAS

LIV_GAINS = LIV_HAUT.replace("{{ titre }}", "Gains") + """
<h2 class="s">💰 Mes gains · {{ mois_affiche }}</h2>
<div class="liv-kp"><div class="stat"><b>{{ g.livrees_mois }}</b><span>livrées ce mois</span></div><div class="stat"><b>{{ g.brut_mois|fcfa }} F</b><span>courses du mois</span></div>
<div class="stat"><b>{{ g.verse_mois|fcfa }} F</b><span>versé ce mois</span></div><div class="stat ambre"><b>{{ g.a_remettre|fcfa }} F</b><span>cash à remettre</span></div>
<div class="stat"><b>{{ g.note or '—' }}</b><span>note moyenne ({{ g.avis_n }} avis)</span></div></div>
<h2 class="s">Cash à remettre</h2>
<div class="carte" style="padding:6px 14px">{% for r in a_remettre %}<div class="liv-row"><div><b>{{ r.numero }}</b><div class="mut">{{ r.client_nom or r.client_tel or 'Client' }}</div></div><b>{{ r.montant_encaisse_livreur|fcfa }} F</b></div>
{% else %}<p class="vide">Rien à remettre pour le moment.</p>{% endfor %}</div>
<h2 class="s">Versements reçus</h2>
<div class="carte" style="padding:6px 14px">{% for v in versements %}<div class="liv-row"><div><b>{{ v.paye_le[:10] }}</b><div class="mut">{{ v.moyen }}{% if v.note %} · {{ v.note }}{% endif %}</div></div><b>+{{ v.montant|fcfa }} F</b></div>
{% else %}<p class="vide">Aucun versement pour l'instant.</p>{% endfor %}</div>
""" + LIV_BAS


def _livreur_connecte():
    identite, reponse = _auth_portail("livreur")
    return identite, reponse


def _liv_ctx(identite, onglet, **extra):
    return dict(livreur=identite["profil"], nom=nom_entreprise(), onglet=onglet,
                msg=request.args.get("msg", "")[:200], **extra)


def _liv_compteurs(nom):
    debut = lundi(date.today()).isoformat()
    aujourdhui = date.today().isoformat()
    with db() as con:
        r = con.execute("SELECT "
                        "COALESCE(SUM(CASE WHEN statut IN ('en attente','collecté') THEN 1 ELSE 0 END),0) en_cours, "
                        "COALESCE(SUM(CASE WHEN statut='livré' AND date(COALESCE(NULLIF(heure_livraison,''),cree_le))=? THEN 1 ELSE 0 END),0) jour, "
                        "COALESCE(SUM(CASE WHEN statut='livré' AND date(COALESCE(NULLIF(heure_livraison,''),cree_le))>=? THEN 1 ELSE 0 END),0) semaine "
                        "FROM livraisons WHERE livreur=?", (aujourdhui, debut, nom)).fetchone()
    return dict(r)


def portail_livreur_v16():
    identite, reponse = _livreur_connecte()
    if reponse:
        return reponse
    livreur = identite["profil"]
    with db() as con:
        lignes = con.execute("SELECT * FROM livraisons WHERE livreur=? AND (statut IN ('en attente','collecté') "
                             "OR (statut='livré' AND statut_paiement!='payé')) ORDER BY id", (livreur["nom"],)).fetchall()
        courses = [{"l": l, "articles": con.execute("SELECT nom, quantite FROM lignes_commande WHERE livraison_id=? ORDER BY id",
                                                    (l["id"],)).fetchall()} for l in lignes]
    c = _liv_compteurs(livreur["nom"])
    return reponse_portail(render_template_string(LIV_COURSES, **_liv_ctx(identite, "courses", courses=courses,
                                                                         en_cours_n=c["en_cours"], jour=c["jour"],
                                                                         semaine=c["semaine"])))


app.view_functions["portail_livreur"] = portail_livreur_v16  # même adresse, nouvel affichage


@app.route("/portail-livreur/historique")
def portail_livreur_historique():
    identite, reponse = _livreur_connecte()
    if reponse:
        return reponse
    with db() as con:
        livraisons = con.execute("SELECT * FROM livraisons WHERE livreur=? AND statut IN ('livré','annulé') "
                                 "ORDER BY id DESC LIMIT 60", (identite["profil"]["nom"],)).fetchall()
    return reponse_portail(render_template_string(LIV_HISTO, **_liv_ctx(identite, "historique", livraisons=livraisons)))


@app.route("/portail-livreur/gains")
def portail_livreur_gains():
    identite, reponse = _livreur_connecte()
    if reponse:
        return reponse
    livreur = identite["profil"]
    nom = livreur["nom"]
    mois = date.today().strftime("%Y-%m")
    with db() as con:
        r = con.execute("SELECT COALESCE(SUM(CASE WHEN statut='livré' THEN 1 ELSE 0 END),0) n, "
                        "COALESCE(SUM(CASE WHEN statut='livré' THEN prix_course ELSE 0 END),0) brut "
                        "FROM livraisons WHERE livreur=? AND substr(date(COALESCE(NULLIF(heure_livraison,''),cree_le)),1,7)=?",
                        (nom, mois)).fetchone()
        verse = con.execute("SELECT COALESCE(SUM(montant),0) FROM paiements_livreurs WHERE livreur_id=? AND substr(paye_le,1,7)=?",
                            (livreur["id"], mois)).fetchone()[0]
        a_remettre = con.execute("SELECT l.numero, l.client_nom, l.client_tel, l.montant_encaisse_livreur FROM livraisons l "
                                 "LEFT JOIN remises_livreurs r ON r.livraison_id=l.id WHERE l.livreur=? AND r.id IS NULL "
                                 "AND COALESCE(l.montant_encaisse_livreur,0)>0 ORDER BY l.id DESC", (nom,)).fetchall()
        avis = con.execute("SELECT ROUND(AVG(note),1) note, COUNT(*) n FROM avis WHERE livreur=?", (nom,)).fetchone()
        versements = con.execute("SELECT montant, moyen, note, paye_le FROM paiements_livreurs WHERE livreur_id=? "
                                 "ORDER BY paye_le DESC, id DESC LIMIT 20", (livreur["id"],)).fetchall()
    g = {"livrees_mois": r["n"], "brut_mois": r["brut"], "verse_mois": verse,
         "a_remettre": sum(int(x["montant_encaisse_livreur"] or 0) for x in a_remettre),
         "note": avis["note"], "avis_n": avis["n"] or 0}
    return reponse_portail(render_template_string(LIV_GAINS, **_liv_ctx(identite, "gains", g=g, a_remettre=a_remettre,
                                                                       versements=versements, mois_affiche=date.today().strftime("%m/%Y"))))


# compte : même page qu'avant, avec les onglets du bas et l'onglet « Compte » sélectionné
PAGE_COMPTE_LIVREUR = "{% set onglet = 'compte' %}" + PAGE_COMPTE_LIVREUR.replace("</main></body></html>", LIV_BAS)


if __name__ == "__main__":
    init_db()
    threading.Thread(target=boucle_relance, daemon=True).start()  # relance des livreurs
    threading.Thread(target=boucle_sauvegarde, daemon=True).start()  # sauvegarde automatique
    # host 0.0.0.0 : accessible aussi depuis ton téléphone sur le même Wi-Fi
    port = max(1, int(os.environ.get("PORT", "5001")))
    while port <= 5100:
        try:
            app.run(host="0.0.0.0", port=port, debug=False)
            break
        except OSError as erreur:
            port_occupe = (getattr(erreur, "winerror", None) == 10048 or
                           getattr(erreur, "errno", None) in (98, 10048))
            if not port_occupe:
                raise
            print(f"Port {port} deja utilise; prochaine adresse : http://localhost:{port + 1}", flush=True)
            port += 1
    if port > 5100:
        raise RuntimeError("Aucun port libre entre 5001 et 5100.")
