# Modele seulement : ne mets pas de vraies cles dans ce fichier.
DOMAINE=livraison.exemple.com
URL_PUBLIQUE=https://livraison.exemple.com
APP_MOT_DE_PASSE=REMPLACER_PAR_UN_MOT_DE_PASSE_LONG
APP_SESSION_SECRET=REMPLACER_PAR_UNE_CLE_ALEATOIRE_LONGUE
BOUTIQUE_PUBLIQUE=1

# Renseigne uniquement les integrations que tu utilises. WA_TOKEN doit être
# émis par un utilisateur Meta confirmé et autoriser whatsapp_business_messaging
# et whatsapp_business_management pour envoyer et gérer les modèles.
WA_TOKEN=
WA_PHONE_ID=
WA_WABA_ID=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_NUMERO_PUBLIC=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
WA_MODE=auto

# Noms exacts des modèles WhatsApp approuvés dans Meta Business Manager.
# Nécessaires aux envois automatiques lorsque la fenêtre de 24 h est fermée.
WA_TEMPLATE_LIVREUR=
WA_TEMPLATE_CLIENT=
WA_TEMPLATE_DEST=
WA_TEMPLATE_LANG=fr

# Numéro WhatsApp de l'équipe à prévenir lorsqu'une commande reste bloquée.
WA_SECRETAIRE=
